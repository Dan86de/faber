{
  "name": "faber",
  "version": "0.1.0",
  "description": "The harness that runs Dan86de/skills unattended",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dan86de/faber"
  },
  "type": "module",
  "bin": {
    "faber": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check && tsc --noEmit && node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.1.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
