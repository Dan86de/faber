{
  "name": "@dan86de/faber",
  "version": "0.2.0",
  "description": "The harness that runs Dan86de/skills unattended",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dan86de/faber.git"
  },
  "type": "module",
  "bin": {
    "faber": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "biome check && tsc --noEmit && node --test \"test/**/*.test.ts\"",
    "changeset": "changeset",
    "release": "sh scripts/release.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.1.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "2.31.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
